# Consumed by docker compose (see compose.yaml). Copy to .env and adjust.
# Keep these values in sync with backend/.env.

# Host UID/GID so container-written files stay editable (`id -u` / `id -g`).
UID=1000
GID=1000

# Published host ports (3000/3306 were already taken on Luật's machine -> 3001/3307)
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=3306

# MySQL
DB_DATABASE=user_management
DB_USERNAME=app
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Frontend -> backend
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
